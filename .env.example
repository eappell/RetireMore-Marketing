# RetireMore Marketing — environment variables
# Copy to .env and fill in. Never commit .env.

# Loops (marketing email)
# https://app.loops.so/settings?page=api
LOOPS_API_KEY=

# PostHog (product analytics)
# https://app.posthog.com → project settings → API keys
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://app.posthog.com

# Resend (transactional email — for test sends only)
# https://resend.com/api-keys
RESEND_API_KEY=

# Stripe (revenue reporting — read-only restricted key recommended)
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Path to the sibling Retire-Portal repo (used by publish-blog.ts)
# Default assumes RetireMore-Marketing and Retire-Portal are siblings.
RETIRE_PORTAL_PATH=../Retire-Portal

# Where the canonical site lives (used in sitemap, schema, UTM defaults)
SITE_URL=https://retiremore.com
